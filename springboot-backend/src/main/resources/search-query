[plus conditions from query];

# RESTAURANT-LEVEL SQL (ALWAYS):
SELECT DISTINCT r.restaurant_id
FROM restaurants r
JOIN food_items fi ON fi.restaurant_id = r.restaurant_id
JOIN food_item_profiles p ON p.item_id = fi.item_id
WHERE r.is_active = TRUE
[plus conditions from query];

