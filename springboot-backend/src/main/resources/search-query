=========================================================
SQL STRUCTURE REQUIREMENTS
=========================================================

# FOOD-LEVEL SQL (ALWAYS):
SELECT fi.item_id, fi.restaurant_id
FROM food_items fi
JOIN food_item_profiles p ON p.item_id = fi.item_id
[optional extra joins if needed]
WHERE fi.is_available = TRUE
[plus conditions from query];

# RESTAURANT-LEVEL SQL (ALWAYS):
SELECT DISTINCT r.restaurant_id
FROM restaurants r
JOIN food_items fi ON fi.restaurant_id = r.restaurant_id
JOIN food_item_profiles p ON p.item_id = fi.item_id
WHERE r.is_active = TRUE
[plus conditions from query];

=========================================================
QUERY INTERPRETATION RULES
=========================================================

# 1. PRICE
“under $12”, “below 10 dollars”, “cheap”, “foods under 30”
→ fi.price <= X

If “cheap” with no number → assume X = 20.

# 2. CALORIES / NUTRITION
“under 300 calories” → p.calories_kcal <= 300
"above 25g protein" → p.protein_g > 25
“high protein” → p.protein_g >= 20
“low carb” → p.carbs_g <= 20

# 3. DIET TYPES
vegan → p.is_vegan = TRUE
gluten free → p.is_gluten_free = TRUE
keto → p.carbs_g <= 25

# 4. ALLERGENS
“without peanuts” → NOT JSON_CONTAINS(p.allergens, JSON_ARRAY('peanuts'))
“contains milk” → JSON_CONTAINS(p.allergens, JSON_ARRAY('milk'))

# 5. SPICE
mild → p.spice_level = 'mild' OR p.spice_score <= 1
medium → p.spice_level = 'medium'
spicy → p.spice_score >= 3
very spicy → p.spice_score >= 4 OR p.spice_level = 'very_spicy'

# 6. CUISINE / TAGS
“Italian dishes” →
r.cuisine LIKE '%italian%' OR JSON_CONTAINS(p.tags, JSON_ARRAY('italian'))

# 7. CATEGORY
“breakfast foods” → p.category_code = 'breakfast'

# 8. INGREDIENT PRESENCE
“with mushrooms” →
JOIN food_item_ingredients fii ON fii.item_id = fi.item_id
JOIN ingredients i ON i.ingredient_id = fii.ingredient_id
AND LOWER(i.name) = 'mushroom'

“without onions/garlic” →
AND NOT EXISTS (
  SELECT 1 FROM food_item_ingredients x
  JOIN ingredients y ON y.ingredient_id = x.ingredient_id
  WHERE x.item_id = fi.item_id AND LOWER(y.name) IN ('onion','garlic')
)

# 9. NAME / TEXT SEARCH
Match across:
fi.display_name
fi.canonical_name
fi.short_description
fi.long_description
Use simple LIKE:
(fi.display_name LIKE '%biryani%' OR fi.canonical_name LIKE '%biryani%')

# 10. ORDER AND LIMIT:
Only use ORDER BY or LIMIT if the user explicitly requests “top”, “highest”, “sorted”, etc.

